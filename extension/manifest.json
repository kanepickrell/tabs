{
  "manifest_version": 3,
  "name": "Tabs — bridge (v0)",
  "version": "0.0.1",
  "description": "Syncs this browser's open tabs to the Tabs Android app, and closes them when you swipe left on your phone.",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": [
    "https://*.firebaseio.com/*",
    "https://*.firebasedatabase.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tabs"
  }
}
